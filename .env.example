# ---------- Required ----------
# Where this app is reachable. Google redirects back here after sign-in.
PUBLIC_URL=http://localhost:8080
# Password for the web app.
ADMIN_PASSWORD=change-me
# Long random string. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------- Google (see docs/google-setup.md) ----------
# OAuth client: lets people connect mailboxes with "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, Workspace admins only: service account with domain-wide delegation.
# GOOGLE_SERVICE_ACCOUNT_FILE=/data/service-account.json

# ---------- Agent ----------
# Cron schedule, read in the TZ timezone.
SCHEDULE=0 7,14,19 * * *
TZ=UTC
# Any current Claude model. claude-haiku-5-5 costs far less per email.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
MAX_EMAILS_PER_RUN=500
MAX_NEW_LABELS_PER_RUN=15
# Optional: post a summary to Slack after every run.
# SLACK_WEBHOOK_URL=

# ---------- Try it without any credentials ----------
# DEMO_MODE=true

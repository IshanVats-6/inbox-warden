# ---------- Required ----------
# Where this app is reachable. Google redirects back here after sign-in.
PUBLIC_URL=http://localhost:8080
# Password for the web app.
ADMIN_PASSWORD=change-me
# Long random string. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Port on this machine (docker compose maps it to the app).
PORT=8080

# ---------- AI (at least one) ----------
# Jev by TypeSafe: fast first pass into existing labels. https://console.typesafe.ai
TYPESAFE_API_KEY=
# Claude: everything Jev is unsure about, and creating new labels. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------- Google (see docs/google-setup.md) ----------
# OAuth client: mailboxes are connected with "Sign in with Google".
# Redirect URI to register: <PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Agent ----------
# Cron schedule, read in the TZ timezone.
SCHEDULE="0 7,14,19 * * *"
TZ=UTC
# Any current Claude model. claude-haiku-5-5 costs far less per email.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Jev decisions below this confidence go to Claude.
JEV_MIN_CONFIDENCE=0.6
MAX_EMAILS_PER_RUN=500
MAX_NEW_LABELS_PER_RUN=15
# Optional: post a summary to Slack after every run.
# SLACK_WEBHOOK_URL=

# ---------- Try it without any credentials ----------
# DEMO_MODE=true
